# Host-side development/test connection. Never commit real credentials.
DATABASE_URL=postgresql://fts_user:change-me@127.0.0.1:5433/fts_db

# Container-side connection to the existing fts-postgres container.
DOCKER_DATABASE_URL=postgresql://fts_user:change-me@fts-postgres:5432/fts_db

# Long, randomly generated operator secret for account bootstrap.
BOOTSTRAP_TOKEN=replace-with-a-long-random-secret

# Optional. If omitted, integration tests derive fts_rebuild_test from DATABASE_URL.
TEST_DATABASE_URL=postgresql://fts_user:change-me@127.0.0.1:5433/fts_rebuild_test

DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
